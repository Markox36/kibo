{
  "expo": {
    "name": "Kibo",
    "slug": "kibo",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kibo",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0a0a0b",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.markox.kibo"
    },
    "android": {
      "package": "dev.markox.kibo",
      "adaptiveIcon": {
        "backgroundColor": "#010d31",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0a0a0b",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#7c8cff"
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "KiboCalendar",
              "label": "Kibo · Hoy",
              "description": "Tus eventos de hoy",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "@react-native-google-signin/google-signin"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
