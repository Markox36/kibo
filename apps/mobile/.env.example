# API backend. Con dispositivo físico por USB: http://localhost:3000 + `adb reverse tcp:3000 tcp:3000`.
# Con emulador también funciona localhost vía adb reverse (o http://10.0.2.2:3000 sin reverse).
EXPO_PUBLIC_API_URL=http://localhost:3000
# OAuth web client ID (mismo que VITE_GOOGLE_CLIENT_ID en apps/web).
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
