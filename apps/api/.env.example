NODE_ENV=development
PORT=3000
API_PUBLIC_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:5173

# Mongo
MONGODB_URI=
MONGODB_DB_NAME=

# JWT
JWT_SECRET=change-me-please-32-chars-minimum-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
# Desktop app OAuth client (Tauri PKCE flow). Must match VITE_GOOGLE_DESKTOP_CLIENT_ID in apps/desktop.
GOOGLE_DESKTOP_CLIENT_ID=

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Kibo <noreply@example.com>"

INTEGRATIONS_KEY=
# Admin panel: email of the user allowed to use /admin endpoints (disabled if empty)
ADMIN_EMAIL=
