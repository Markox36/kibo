VITE_API_URL=http://localhost:3000

# Google OAuth (Desktop app client — Tauri PKCE flow)
# Must match GOOGLE_DESKTOP_CLIENT_ID in apps/api.
VITE_GOOGLE_DESKTOP_CLIENT_ID=
# Optional: only if the OAuth client type is "Web" instead of "Desktop app".
VITE_GOOGLE_DESKTOP_CLIENT_SECRET=

# Optional: legacy web-flow client id (Google Identity Services popup).
VITE_GOOGLE_CLIENT_ID=
